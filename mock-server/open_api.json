    "responses": {
      "BadRequest": {
        "description": "A field is missing or invalid, or a file id isn't yours.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "rest_missing_callback_param": {
                "value": {
                  "code": "rest_missing_callback_param",
                  "message": "Missing parameter(s): instrument",
                  "data": {
                    "status": 400,
                    "params": [
                      "instrument"
                    ]
                  }
                }
              },
              "rest_invalid_param": {
                "value": {
                  "code": "rest_invalid_param",
                  "message": "Invalid parameter(s): schemaVersion",
                  "data": {
                    "status": 400,
                    "params": {
                      "schemaVersion": "schemaVersion must be an integer of at least 1."
                    }
                  }
                }
              },
              "oli_invalid_file_ref": {
                "value": {
                  "code": "oli_invalid_file_ref",
                  "message": "One or more files could not be found.",
                  "data": {
                    "status": 400,
                    "fileIds": [
                      999
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "NotLoggedIn": {
        "description": "Not logged in, or no `X-WP-Nonce` was sent.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "code": "oli_not_logged_in",
              "message": "You need to be logged in to save.",
              "data": {
                "status": 401
              }
            }
          }
        }
      },
      "Forbidden": {
        "description": "The security token has expired (get a new one and retry), saving is switched off for this instrument, this account can't save, or application passwords aren't allowed from here.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "rest_cookie_invalid_nonce": {
                "value": {
                  "code": "rest_cookie_invalid_nonce",
                  "message": "Cookie check failed",
                  "data": {
                    "status": 403
                  }
                }
              },
              "oli_instrument_disabled": {
                "value": {
                  "code": "oli_instrument_disabled",
                  "message": "Saving is not available for this instrument yet.",
                  "data": {
                    "status": 403
                  }
                }
              },
              "oli_forbidden": {
                "value": {
                  "code": "oli_forbidden",
                  "message": "You are not allowed to save.",
                  "data": {
                    "status": 403
                  }
                }
              },
              "oli_app_passwords_disabled": {
                "value": {
                  "code": "oli_app_passwords_disabled",
                  "message": "Application passwords cannot be used here.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "Doesn't exist, or belongs to someone else.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "code": "oli_not_found",
              "message": "Not found.",
              "data": {
                "status": 404
              }
            }
          }
        }
      },
      "DataTooLarge": {
        "description": "`data` is over the size limit.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "code": "oli_data_too_large",
              "message": "This save is too large.",
              "data": {
                "status": 413,
                "maxBytes": 262144
              }
            }
          }
        }
      },
      "FileTooLarge": {
        "description": "The file is over the size limit.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "code": "oli_file_too_large",
              "message": "This file is too large.",
              "data": {
                "status": 413,
                "maxBytes": 10485760
              }
            }
          }
        }
      },
      "UnsupportedType": {
        "description": "This file type isn't allowed for the instrument.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "code": "oli_unsupported_type",
              "message": "This type of file is not allowed.",
              "data": {
                "status": 415,
                "allowedMimes": [
                  "audio/mpeg",
                  "image/jpeg",
                  "image/png"
                ]
              }
            }
          }
        }
      },
      "RateLimited": {
        "description": "Too many saves or uploads. Wait `retryAfter` seconds.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "code": "oli_rate_limited",
              "message": "Too many saves. Please wait a moment.",
              "data": {
                "status": 429,
                "retryAfter": 30
              }
            }
          }
        }
      },
      "ServerError": {
        "description": "Something went wrong on the server. Try again later.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "oli_upload_failed": {
                "value": {
                  "code": "oli_upload_failed",
                  "message": "The upload failed. Please try again.",
                  "data": {
                    "status": 500
                  }
                }
              },
              "oli_db_error": {
                "value": {
                  "code": "oli_db_error",
                  "message": "Could not save. Please try again.",
                  "data": {
                    "status": 500
                  }
                }
              }
            }
          }
        }
      },
      "QuotaExceeded": {
        "description": "The user's storage is full.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "code": "oli_quota_exceeded",
              "message": "You have used all your storage space.",
              "data": {
                "status": 507,
                "quotaUsed": 209715200,
                "quotaLimit": 209715200
              }
            }
          }
        }
      }
    }
  }
